# Development only. Run commands from the repository root.
EAH_DATABASE_URL=postgresql+psycopg://eah:eah_dev@127.0.0.1:5432/eah
EAH_REDIS_URL=redis://127.0.0.1:6379/0
EAH_API_HOST=127.0.0.1
EAH_API_PORT=8300
# Exact browser origins. Set Secure=true and HTTPS origins in a deployed environment.
EAH_BROWSER_ORIGINS=["http://127.0.0.1:3300","http://localhost:3300"]
EAH_COOKIE_SECURE=false
# Local SeaweedFS S3; start with docker compose --profile storage up -d --wait.
EAH_S3_ENDPOINT=http://127.0.0.1:4566
EAH_S3_REGION=us-east-1
EAH_S3_BUCKET=eah-development
EAH_S3_ACCESS_KEY=test
EAH_S3_SECRET_KEY=test
EAH_S3_PREFIX=eah/uploads/
EAH_MAX_DOCUMENTS_PER_ORGANIZATION=1000
# Development ingestion container DNS; keep model private/reserved address checks enabled.
EAH_WORKER_DNS=223.5.5.5
# Optional deployment-only overrides (JSON); browser requests cannot change them.
# EAH_MODEL_BASE_URLS={"openai-chat":["https://api.openai.com/v1"],"dashscope-chat":["https://dashscope.aliyuncs.com/compatible-mode/v1"],"openai-embeddings":["https://api.openai.com/v1","https://dashscope.aliyuncs.com/compatible-mode/v1"],"cohere-rerank-v2":["https://api.cohere.com/v2"],"dashscope-rerank":["https://dashscope.aliyuncs.com/api/v1"]}
# EAH_CHAT_TOKENIZERS={"gpt-4o-mini-2024-07-18":"o200k_base","gpt-4o-2024-08-06":"o200k_base","qwen-plus":"dashscope-qwen-1.26.7"}
# EAH_SYSTEM_LIMITS={"maxRunSteps":10,"maxToolAttempts":10,"runDeadlineSeconds":120,"maxRunTokens":16000,"maxUploadBytes":20971520,"maxActiveRunsPerOrganization":2,"maxQueuedRunsPerOrganization":20}

# Dedicated local admin connection for temporary smoke databases.
# Optional dedicated run queue; API dispatcher and Linux consumer must match.
# EAH_RUN_QUEUE=eah.runs
EAH_TEST_ADMIN_URL=postgresql://eah:eah_dev@127.0.0.1:5432/postgres

# Explicit real-service probes only. Empty values mean UNVERIFIED, exit code 2.
EAH_PROBE_API_KEY=
EAH_PROBE_BASE_URL=
EAH_PROBE_CHAT_MODEL=
EAH_PROBE_EMBEDDING_MODEL=
EAH_PROBE_GITHUB_TOKEN=
EAH_PROBE_RERANK_API_KEY=
EAH_PROBE_RERANK_BASE_URL=
EAH_PROBE_RERANK_MODEL=
# Optional protocol overrides; omit to use OpenAI/Cohere defaults.
# EAH_PROBE_CHAT_PROTOCOL=dashscope-chat
# EAH_PROBE_EMBEDDING_PROTOCOL=openai-embeddings
# EAH_PROBE_RERANK_PROTOCOL=dashscope-rerank
# Bailian bases/models and opt-in real API acceptance: README, Engineering verification.
